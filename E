local function classifyESPObject(obj)
    if not obj or not obj.Parent then return nil end
    if isInLobby(obj) then return nil end
    if not (obj:IsA("Model") or obj:IsA("Tool") or obj:IsA("BasePart")) then return nil end
    if LocalPlayer.Character and (obj == LocalPlayer.Character or obj:IsDescendantOf(LocalPlayer.Character)) then return nil end
    if obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) == LocalPlayer then return nil end
    if isFakeGenerator(obj) then return nil end
    local name = string.lower(obj.Name)
    if obj:IsA("Model") then
        local explicitBots = {"minimon", "minion", "bot", "puppet", "1x1x1x1zombie", "servant"}
        for _, bName in ipairs(explicitBots) do
            if string.find(name, bName, 1, true) then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local isPlayer = Players:GetPlayerFromCharacter(obj) ~= nil
                if hum and not isPlayer then
                    return "Bot"
                end
            end
        end
    end
    if obj:IsA("BasePart") or obj:IsA("Model") then
        if isJohnDoeSummon(obj) then
            return "Shadow"
        end
    end
    if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
        local player = Players:GetPlayerFromCharacter(obj)
        for killerName in pairs(KillerNamesList) do
            if string.find(name, killerName, 1, true) then return "Killer" end
        end
        if string.find(name, "killer", 1, true) then return "Killer" end
        if not player then
            local botKeywords = {
                "summon", "decoy", "helper", "harp", "guitar",
                "pizzadeliveryrig", "blue", "green", "purple", "red", "mafia", "corrupt"
            }
            for _, keyword in ipairs(botKeywords) do
                if string.find(name, keyword, 1, true) then
                    return "Bot"
                end
            end
            if hasFullRig(obj) and not isNPC(obj) then
                return "Bot"
            end
        end
        if player and player ~= LocalPlayer then return "Survivors" end
        for survivorName in pairs(SurvivorNamesList) do
            if string.find(name, survivorName, 1, true) then return "Survivors" end
        end
        if string.find(name, "survivor", 1, true) then return "Survivors" end
        return nil
    end
    if string.find(name, "generator", 1, true) then
        if isFakeGenerator(obj) then return nil end
        return "Generators"
    end
    if name == "bloxycola" or name == "bloxy cola" then
        if obj:IsA("Tool") and not isInPlayerInventory(obj) and not isInLobby(obj) then return "BloxyCola" end
        return nil
    end
    if name == "medkit" or name == "med kit" then
        if obj:IsA("Tool") and not isInPlayerInventory(obj) and not isInLobby(obj) then return "Medkit" end
        return nil
    end
    if name == "digital footprint" or name == "digitalfootprint" then
        if not isInPlayerInventory(obj) then return "DigitalFootprint" end
        return nil
    end
    if isGearItem(obj) then
        return "Gear"
    end
    return nil
end

local GenDoneNames = { "completed", "complete", "done", "repaired", "finished", "fixed", "isdone", "iscomplete" }

local function normalizeGenProgress(n)
    if type(n) ~= "number" or n ~= n or n < 0 or n > 100 then return nil end
    if n > 0 and n < 1 then return n end -- already a 0..1 fraction
    return n / 100
end

local function isProgressName(name, exact)
    local lname = string.lower(name)
    if exact then return lname == "progress" end
    return string.find(lname, "progress", 1, true) ~= nil
        or string.find(lname, "percent", 1, true) ~= nil
        or string.find(lname, "completion", 1, true) ~= nil
end

local function isDoneName(name)
    local lname = string.lower(name)
    for _, w in ipairs(GenDoneNames) do
        if lname == w then return true end
    end
    return false
end

local function scanGeneratorProgress(genObj, exact)
    for name, val in pairs(genObj:GetAttributes()) do
        if type(val) == "number" and isProgressName(name, exact) then
            local p = normalizeGenProgress(val)
            if p then return p end
        end
    end
    for _, d in ipairs(genObj:GetDescendants()) do
        if (d:IsA("NumberValue") or d:IsA("IntValue")) and isProgressName(d.Name, exact) then
            local p = normalizeGenProgress(d.Value)
            if p then return p end
        end
    end
    return nil
end

local function getGeneratorProgressPercent(genObj)
    if not genObj then return nil end
    for name, val in pairs(genObj:GetAttributes()) do
        if val == true and isDoneName(name) then return 1 end
    end
    for _, d in ipairs(genObj:GetDescendants()) do
        if d:IsA("BoolValue") and d.Value and isDoneName(d.Name) then return 1 end
    end
    local exactHit = scanGeneratorProgress(genObj, true)
    if exactHit ~= nil then return exactHit end
    return scanGeneratorProgress(genObj, false)
end

local function updateSingleESP(obj, catKey)
    if not obj or not obj.Parent or isInLobby(obj) or isFakeGenerator(obj) then return end
    local info = ESPCategories[catKey]
    if not info then return end
    local isEnabled = Settings[info.ConfigKey]
    local color = Settings[info.ColorKey]
    if catKey == "Generators" then
        local percent = getGeneratorProgressPercent(obj)
        if percent == nil then
        
        elseif percent >= 0.999 then
            color = Color3.fromRGB(0, 255, 0)
        elseif percent >= 0.8 then
            color = Color3.fromRGB(150, 255, 0)
        elseif percent >= 0.6 then
            color = Color3.fromRGB(255, 255, 0)
        elseif percent >= 0.4 then
            color = Color3.fromRGB(255, 170, 0)
        elseif percent >= 0.2 then
            color = Color3.fromRGB(255, 85, 0)
        else
            color = Color3.fromRGB(255, 0, 0)
        end
    end
    local highlight = obj:FindFirstChild("DuckHighlight")
    if isEnabled then
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "DuckHighlight"
            highlight.Adornee = obj
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.Parent = obj
        end
        local oldGearHL = obj:FindFirstChild("GearHighlight")
        if oldGearHL then oldGearHL:Destroy() end
        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.Enabled = true
    else
        if highlight then highlight.Enabled = false end
    end
end

local function refreshAllESP()
    for obj, catKey in pairs(trackedESP) do
        if isFakeGenerator(obj) then
            if obj and obj:FindFirstChild("DuckHighlight") then obj.DuckHighlight:Destroy() end
            trackedESP[obj] = nil
        else
            local isSelf = false
            if LocalPlayer.Character and (obj == LocalPlayer.Character or obj:IsDescendantOf(LocalPlayer.Character)) then isSelf = true end
            if obj and obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) == LocalPlayer then isSelf = true end
            local isDead = false
            if catKey == "Survivors" or catKey == "Killer" or catKey == "Bot" then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then isDead = true end
            end
            if obj and obj.Parent and not isInLobby(obj) and not isSelf and not isDead then
                updateSingleESP(obj, catKey)
            else
                if obj and obj:FindFirstChild("DuckHighlight") then obj.DuckHighlight:Destroy() end
                if isDead or not obj or not obj.Parent then trackedESP[obj] = nil end
            end
        end
    end
end

local function registerESPObject(obj)
    if not obj or not obj.Parent then return end
    if isInLobby(obj) or isFakeGenerator(obj) then return end
    local catKey = classifyESPObject(obj)
    if not catKey then return end
    local currentParent = obj.Parent
    local isNested = false
    while currentParent and currentParent ~= Workspace do
        if isFakeGenerator(currentParent) then return end
        if trackedESP[currentParent] then
            isNested = true
            break
        end
        currentParent = currentParent.Parent
    end
    if not isNested or catKey == "Bot" or catKey == "Shadow" then
        trackedESP[obj] = catKey
        updateSingleESP(obj, catKey)
    end
end

local function pruneShadowESP()
    local maxCount = Settings.EspShadowMaxCount or 3
    if maxCount <= 0 then return end
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local shadows = {}
    for obj, cat in pairs(trackedESP) do
        if cat == "Shadow" and obj and obj.Parent then
            local hrp = obj:FindFirstChild("HumanoidRootPart") or (obj:IsA("BasePart") and obj)
            if hrp then
                local dist = (hrp.Position - myHRP.Position).Magnitude
                table.insert(shadows, {obj = obj, dist = dist})
            end
        end
    end
    if #shadows <= maxCount then return end
    table.sort(shadows, function(a, b) return a.dist < b.dist end)
    for i = maxCount + 1, #shadows do
        local obj = shadows[i].obj
        if obj and obj:FindFirstChild("DuckHighlight") then obj.DuckHighlight:Destroy() end
        trackedESP[obj] = nil
    end
end

