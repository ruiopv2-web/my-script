local QuickBtn = Instance.new("TextButton")

local function ApplyLanguage()
    for _, entry in ipairs(UILanguageRegistry) do
        if entry.Type == "Tab" then
            entry.Obj.Text = entry.Texts[Settings.Language]
        elseif entry.Type == "Toggle" then
            local statusText = entry.GetValue() and "ON" or "OFF"
            entry.Obj.Text = "   " .. entry.Texts[Settings.Language] .. " : " .. statusText
            entry.Obj.BackgroundColor3 = entry.GetValue() and Color3.fromRGB(40, 140, 60) or Color3.fromRGB(40, 40, 40)
        elseif entry.Type == "Input" then
            entry.Obj.Text = entry.Texts[Settings.Language]
            if entry.BoxObj and entry.GetSettingVal then
                entry.BoxObj.Text = tostring(entry.GetSettingVal())
            end
        elseif entry.Type == "QuickBtn" then
            local statusText = entry.GetValue() and "ON" or "OFF"
            entry.Obj.Text = entry.Texts[Settings.Language] .. ": " .. statusText
            QuickBtn.BackgroundColor3 = Settings.MasterAutoBlock and Color3.fromRGB(40, 160, 60) or Color3.fromRGB(180, 40, 40)
        elseif entry.Type == "Header" then
            entry.Obj.Text = entry.Texts[Settings.Language]
        elseif entry.Type == "Paragraph" then
            entry.TitleObj.Text = entry.Titles[Settings.Language]
            entry.ContentObj.Text = entry.Contents[Settings.Language]
        end
    end
end

