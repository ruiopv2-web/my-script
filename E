local function isIgnoredSoundSource(sound)
    if not sound then return true end
    local soundName = string.lower(sound.Name)
    for _, keyword in ipairs(IgnoredKeywords) do
        if string.find(soundName, keyword) then
            return true
        end
    end
    local current = sound.Parent
    while current and current ~= Workspace do
        local currentName = string.lower(current.Name)
        for _, keyword in ipairs(IgnoredKeywords) do
            if string.find(currentName, keyword) then
                return true
            end
        end
        current = current.Parent
    end
    return false
end

local function setupSound(sound)
    if not sound:IsA("Sound") or hookedSounds[sound] then return end
    hookedSounds[sound] = true
    local function refreshSoundCache()
        local rawId = sound.SoundId
        if not rawId or rawId == "" then soundDataCache[sound] = nil return end
        local numId = string.match(rawId, "%d+$")
        if not numId then soundDataCache[sound] = nil return end
        if isIgnoredSoundSource(sound) then
            soundDataCache[sound] = nil
            return
        end
        local isKiller = KillerSounds and KillerSounds[numId] == true
        if not isKiller then soundDataCache[sound] = nil return end
        soundDataCache[sound] = {
            numId = numId,
            character = sound:FindFirstAncestorOfClass("Model"),
            customConfig = SoundCustomConfig and SoundCustomConfig[numId],
            lastTriggerTime = 0
        }
    end
    refreshSoundCache()
    sound:GetPropertyChangedSignal("SoundId"):Connect(refreshSoundCache)
    sound:GetPropertyChangedSignal("Parent"):Connect(refreshSoundCache)
    local function onSoundTriggered()
        if not Settings.AutoBlockSound then return end
        if isIgnoredSoundSource(sound) then return end
        local cache = soundDataCache[sound]
        if not cache then return end
        local currentTime = os.clock()
        if currentTime - cache.lastTriggerTime < 0.01 then return end
        cache.lastTriggerTime = currentTime
        local character = cache.character or sound:FindFirstAncestorOfClass("Model")
        if not character then return end
        if not cache.character then cache.character = character end
        if character ~= LocalPlayer.Character and Settings.MasterAutoBlock then
            local myChar = LocalPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if myHRP and hrp then
                local pingSec = getPingCompensation()
                local pingPrediction = pingSec * 22
                local maxReach = Settings.BoxSizeDepth + Settings.HitboxDistance + 3 + pingPrediction
                local diff = myHRP.Position - hrp.Position
                local distSq = (diff.X * diff.X) + (diff.Y * diff.Y) + (diff.Z * diff.Z)
                if distSq <= (maxReach * maxReach) then
                    local forwardOffset = - (Settings.BoxSizeDepth / 2) - Settings.HitboxDistance
                    local boxCenter = hrp.CFrame * CFrame.new(0, 0, forwardOffset)
                    local localPos = boxCenter:ToObjectSpace(myHRP.CFrame).Position
                    local halfW = Settings.BoxSizeWidth / 2
                    local halfH = Settings.BoxSizeHeight / 2
                    local halfD = (Settings.BoxSizeDepth / 2) + pingPrediction
                    if math.abs(localPos.X) <= halfW and math.abs(localPos.Y) <= halfH and math.abs(localPos.Z) <= halfD then
                        performBlock()
                    end
                end
            end
        end
        spawnHitboxAndCheck(character, cache.customConfig)
    end
    sound.Played:Connect(onSoundTriggered)
    sound.Resumed:Connect(onSoundTriggered)
    sound:GetPropertyChangedSignal("Playing"):Connect(function()
        if sound.IsPlaying then onSoundTriggered() end
    end)
    if sound.IsPlaying then onSoundTriggered() end
end

