local function promptLooksLikePickup(prompt)
    local text = string.lower(tostring(prompt.ActionText) .. " " .. tostring(prompt.ObjectText))
    for _, w in ipairs(PickupPromptWords) do
        if string.find(text, w, 1, true) then return true end
    end
    return false
end

local function hasPrompt(obj, needPickupText)
    local function matches(p)
        return p:IsA("ProximityPrompt") and (not needPickupText or promptLooksLikePickup(p))
    end
    for _, c in ipairs(obj:GetChildren()) do
        if matches(c) then return true end
        if obj:IsA("Model") and c:IsA("BasePart") then
            for _, cc in ipairs(c:GetChildren()) do
                if matches(cc) then return true end
            end
        end
    end
    return false
end

